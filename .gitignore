# ============================================================
# 全国大学生电子设计竞赛备赛仓库 .gitignore
# ============================================================

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# Office 临时锁文件（~$xxx.docx / ~$xxx.xlsx ...）
~$*

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ---------- Keil MDK ----------
Listings/
Objects/
*.uvguix.*
*.uvopt
*.bak
*.dep
*.crf
*.d
*.iex
*.htm
*.lnp
*.plg
*.scvd
*.tra
*.txt.~*
*.lst

# ---------- STM32CubeIDE / GCC ----------
Debug/
Release/
build/
*.elf
*.map
*.list

# ---------- 通用编译产物 ----------
*.o
*.obj
*.lib
*.a
*.exe
*.out
*.hex
*.bin
*.axf

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 备赛仓库专属：不该入库的大文件/无关文件 ----------
# 安卓安装包（不要把 VPN apk 提交到公开仓库）
*.apk

# 临时截图（如有需要保留请单独移到正式目录）
Screenshot_*.jpg
Screenshot_*.png

# 大型二进制资料（pdf/docx 默认保留，确认要排除时取消下面注释）
# *.pdf
# *.docx

# Altium / KiCad 临时
*.PrjPcbStructure
*.PcbDoc.htm
*-cache.lib
*-rescue.lib
fp-info-cache

# 仿真临时
*.raw
*.log
*.net

# ---------- LaTeX 编译中间产物（报告 .tex → PDF；保留 .tex/.pdf/.docx）----------
*.aux
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.fdb_latexmk
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.idx
*.ilg
*.ind
_build*.log
_buildrun.log

# ---------- 本仓库工具脚本临时输出 ----------
tmp_*.txt
*.tmp
# headless 编译/烧录日志 + 串口桥运行时文件（build_flash.ps1 / serial_bridge.ps1 产出）
_build_log.txt
_flash_log.txt
_*_scan.txt
serial_log.txt
serial_cmd.txt
# PID 调参串口抓数 CSV（tune_step.ps1 产出，按需手动归档关键几条到 04_调试记录）
workbench/Main/tools/logs/

# 微信/即时通讯导出的临时截图（正式图请移入 02_硬件 等目录并改名）
微信图片_*.jpg
微信图片_*.png
WeChat_*.jpg

# ---------- 旁支归档 scaffold 自测产物 ----------
_archive/跨赛事方法论/scaffold/scaffold_test_out/

# ---------- 误放入的仓库自身重复克隆（与根仓库同源同 HEAD） ----------
/26/

# ---------- workbench 第三方参考工程（学习用，体积大+含编译产物，不入库；保留 README 记录出处） ----------
workbench/_参考工程/15.VL53L0X激光测距实验/
workbench/_参考工程/9-4 串口收发文本数据包/
# 兼容历史误放在 workbench 根目录的同名参考工程
workbench/15.VL53L0X激光测距实验/
workbench/9-4 串口收发文本数据包/

# 工程整包备份（勿入库，体积大）
*.zip
