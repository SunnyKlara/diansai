diff --git a/main/lvgl_demo.c b/main/lvgl_demo.c
index 19af89f..7bce46f 100644
--- a/main/lvgl_demo.c
+++ b/main/lvgl_demo.c
@@ -10,8 +10,33 @@
 #include "lvgl.h"
 #include "demos/lv_demos.h"
 
+#include "ai_panel.h"
+
 static const char *TAG = "lvgl";
 
+// ====== 帧率探针（本仓库新增）======
+// LVGL 的 PERF_MONITOR 只把 FPS 画在屏幕角上，串口拿不到 —— AI 看不见屏，
+// 跑分就无法定量对账。这里数 display 的刷新完成事件，自己往串口打 FPS。
+// 与 demo 类型无关（widgets / benchmark / ai_panel 都适用）。
+static uint32_t s_refr_count;
+
+static void refr_ready_cb(lv_event_t *e)
+{
+    LV_UNUSED(e);
+    s_refr_count++;
+}
+
+static void fps_report_cb(lv_timer_t *t)
+{
+    LV_UNUSED(t);
+    static uint32_t sec;
+    sec += 2;
+    const uint32_t n = s_refr_count;
+    s_refr_count = 0;
+    ESP_LOGI(TAG, "FPS %.1f  (refreshes=%lu in 2s, t=%lus)",
+             (float)n / 2.0f, (unsigned long)n, (unsigned long)sec);
+}
+
 esp_err_t lvgl_start(const lcd_panel_desc_t *pd,
                      esp_lcd_panel_handle_t panel,
                      esp_lcd_panel_handle_t control_panel,
@@ -78,6 +103,13 @@ esp_err_t lvgl_start(const lcd_panel_desc_t *pd,
         pd->touch_attach(disp, tp_pins, pd->h_res, pd->v_res);
     }
 
+    // 帧率探针：刷新完成计数 + 每 2s 往串口报一次
+    if (lvgl_port_lock(0)) {
+        lv_display_add_event_cb(disp, refr_ready_cb, LV_EVENT_REFR_READY, NULL);
+        lv_timer_create(fps_report_cb, 2000, NULL);
+        lvgl_port_unlock();
+    }
+
     // 打印本次跑分对应的缓冲配置：跑分数据必须能对应到具体配置才有意义
     ESP_LOGI(TAG,
              "📊 基准配置 | 缓冲 %lu px ×%d | %s | dma=%d spiram=%d | direct=%d 避撕裂=%d | 旋转 %d° sw_rotate=%d PPA=%s",
@@ -94,13 +126,17 @@ esp_err_t lvgl_start(const lcd_panel_desc_t *pd,
 
     // 加载 demo（LVGL API 调用需加锁）
     if (lvgl_port_lock(0)) {
-#if LVGL_DEMO_BENCHMARK
+#if LVGL_DEMO_AI_PANEL
+        ai_panel_create();
+#elif LVGL_DEMO_BENCHMARK
         lv_demo_benchmark();
 #else
         lv_demo_widgets();
 #endif
         lvgl_port_unlock();
-        ESP_LOGI(TAG, "✅ %s 已加载", LVGL_DEMO_BENCHMARK ? "lv_demo_benchmark" : "lv_demo_widgets");
+        ESP_LOGI(TAG, "✅ %s 已加载",
+                 LVGL_DEMO_AI_PANEL ? "ai_panel(自绘验证面板)"
+                                    : (LVGL_DEMO_BENCHMARK ? "lv_demo_benchmark" : "lv_demo_widgets"));
