diff --git a/main/lvgl_demo.h b/main/lvgl_demo.h
index 8f7a320..6540ac5 100644
--- a/main/lvgl_demo.h
+++ b/main/lvgl_demo.h
@@ -24,6 +24,20 @@ extern "C" {
 #define LVGL_DEMO_BENCHMARK  0
 #endif
 
+// ====== 🔍 自绘验证面板开关（本仓库新增，非上游）======
+// 1 = 跑 ai_panel（自绘：固件编译时间 + 运行秒数 + 触摸坐标 + 跟手圆点 + 四角靶标）
+// 0 = 走上面两个上游 demo
+// 用途：真机验证「显示确实受这份固件控制」「触摸坐标映射对不对」。
+// 优先级高于 LVGL_DEMO_BENCHMARK。
+// 跑分实测(2026-07-27, 1280x452 RGB888 + PPA 硬件旋转 + PSRAM 双局部缓冲)：
+//   简单场景 57~63.5 FPS(受 LV_DEF_REFR_PERIOD=15ms≈66Hz 上限约束)，
+//   重场景(大面积渐变/图像/阴影) 11.5~17 FPS，全程无 panic/WDT。
+//   复现方法：把本开关设 1、AI_PANEL 设 0，重新编译烧录，看串口 "lvgl: FPS x.x"
+//   （帧率探针在 lvgl_demo.c，PERF_MONITOR 只画在屏上、串口拿不到）。
+#ifndef LVGL_DEMO_AI_PANEL
+#define LVGL_DEMO_AI_PANEL   1
+#endif
+
 // 用面板描述 + 已建好的面板句柄启动 LVGL（含触摸，触摸失败不影响显示），
 // 并加载 lv_demo_widgets。LVGL 刷新由 esp_lvgl_port 后台任务负责。
 esp_err_t lvgl_start(const lcd_panel_desc_t *panel_desc,
