# ESP32-P4 纯屏幕(ST7703 MIPI-DSI) + LVGL 分支默认配置。
# IDF 仅在存在基础 sdkconfig.defaults 时才读取默认值，故都放本文件。

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ESP32-P4 v1.x 芯片（v3.x 请用 menuconfig 切换）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Flash 与分区：本板实测 flash 为 16MB（Boya 0x68/0x4018），原配置只声明 4MB、
# 白扔 12MB（旧固件启动会警告 "Detected size(16384k) larger than ... (4096k)"）。
# factory 同步放大到 8M（partitions.csv）。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM：MIPI DSI 帧缓冲(720x720x2x2≈2MB)必须放 PSRAM。
# 若本板 PSRAM 不同导致开机初始化失败，调低 SPEED 或改模式。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_LDO_RESERVE_PSRAM=y
CONFIG_ESP_LDO_CHAN_PSRAM_DOMAIN=2
CONFIG_ESP_LDO_VOLTAGE_PSRAM_1800_MV=y
CONFIG_LCD_DSI_ISR_HANDLER_IN_IRAM=y

# LVGL（9.x）+ widgets demo
# LVGL 原生渲染保持 RGB565；AXS15260 在显示设备层显式使用 RGB888
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_DEMO_WIDGETS=y
# 基准测试用（lvgl_demo.c 按 LVGL_DEMO_BENCHMARK 宏切换，默认仍跑 widgets）
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_SYSMON=y

# PPA 硬件旋转：esp_lvgl_port 在 sw_rotate 且旋转角>0 时改用 P4 的 PPA 外设做旋转，
# 替代 CPU 逐像素软旋转（色彩格式按 RGB565/RGB888 自动选择）。当前受益的是
# AXS15260(6.2 寸) 与 GX610(12 寸) 两块 90° 旋转屏。
CONFIG_LVGL_PORT_ENABLE_PPA=y

# RGB888 PSRAM 局部缓冲按正常范例使用性能优化，保证持续拷贝带宽
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 与范例 esp32p4_6.2in_axs15260d 对齐（范例配置已实测可正常点亮 6.2 屏）。
# ⚠️ IDF_EXPERIMENTAL_FEATURES 是 6.2 屏花屏根因：P4 上它关系到 200MHz PSRAM /
#    MSPI 时序，本工程代码 XIP on PSRAM，缺此项时高速 PSRAM 时序偏差会悄悄
#    损坏 framebuffer/DSI 配置导致花屏（不崩溃）。FREERTOS_HZ 一并对齐。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_FREERTOS_HZ=1000
# 6.2 屏 1280x452 + 软件旋转的首次渲染较重，会占住 CPU0 超过默认 5s 看门狗
# 超时导致 IDLE0 饿死 panic（范例即关闭 task_wdt）；timer 任务栈同步加大。
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# 日志走 USB-JTAG(COM82)，便于联机查看；如需 UART 控制台删除此行
# 顺带：这也让开了 GPIO37/38 —— 那是本板 P4<->C5 的 UART，控制台占着会打架。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ============ 方案 D 无线图传：板载 ESP32-C5 协处理器（esp_hosted / SDIO）============
# 下面这一段与 p4_sta_host/sdkconfig.defaults 同源（那个工程已真机验证：扫到 51 个
# AP、关联 K230_AP 并 ping 5/5、1025 帧视频零坏帧）。搬过来时一个字都没改，
# 目的就是不引入新自变量。
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

# 协处理器是 C5。esp_wifi_remote 在任何 ESP32-P4 主机上都默认 slave=C6，
# 不改这行会编出错的 WiFi/RPC 特性集（这一行同时翻 ESP_HOSTED_CP_TARGET_ESP32C5）。
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# SDIO 必须用 slot 1（可自由布线）。slot 0 在 P4 上被 IOMUX 固定到
# CLK43/CMD44/D0-D3=39..42，那是 microSD 的位置。
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17

# 从机复位脚（C5 的 EN）。36 是猜的、但猜对了（实测能起来）；
# "不用复位脚"不是选项：eh_host_bus_sdio.c 对 pin==-1 直接 assert。
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=36
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y

# 要连的 AP（拓扑 C：K230 当 AP + 视频服务端，网关 192.168.169.1）。
# PSK 只存在于本 gitignored 树内（本文件 + p4_sta_host/sdkconfig.defaults）；
# 入库的证据副本里一律是 <K230_AP_PSK> 占位符。
CONFIG_P4V_WIFI_SSID="K230_AP"
CONFIG_P4V_WIFI_PASSWORD="<K230_AP_PSK>"
CONFIG_P4V_PING_ON_BOOT=y
