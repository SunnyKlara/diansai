# Coprocessor OTA Example — host (MCU)

# Role: HOST (MCU / ESP-IDF)
CONFIG_ESP_HOSTED=y

CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y

# Custom partition table — ota_0/1 for HTTPS, storage for LittleFS, slave_fw for Partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_FREERTOS_HZ=1000

# ============ FRENIX ESP32-P4 DevBoard R5 board adaptation ============
# Board: ESP32-P4NRW32 + on-board ESP32-C5-MINI-1-N4 co-processor.
# Facts below come from the in-repo schematic PDF
# (workbench/ESP32P4_屏板/资料/ESP32P4-DevBoard_Schematic_2026-07-14.pdf)
# cross-checked against esp_hosted's own per-board Kconfig defaults.

# The co-processor is a C5. esp_wifi_remote defaults the "slave target" to
# ESP32-C6 on any ESP32-P4 host, which would build the wrong Wi-Fi/RPC feature
# set. This one line also flips CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5.
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# SDIO must use slot 1 (freely routable pins). Slot 0 is IOMUX-fixed to
# CLK43/CMD44/D0-D3=39-42 on the P4 and is where the microSD card lives, so
# keeping the C5 on slot 1 lets the SD card and the radio coexist.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17

# Slave reset (C5 EN). 36 is a best-effort value, NOT yet confirmed:
# the schematic text puts net C5_EN next to P4 IO36 and IO36 carries no other
# function on this board, so driving it is harmless even if the guess is wrong.
# "No reset pin" is not an option -- eh_host_bus_sdio.c asserts on pin == -1.
# EN is pulled up on the board, so the C5 runs even if the host never drives it.
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=36
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y

# The default UART0 console sits on GPIO37/38 -- which on this board is the
# P4 <-> C5 UART. Move the console onto USB-Serial-JTAG (the Type-C silkscreened
# "UART", COM7 on this PC) so the console and the C5 stop fighting over the pins.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- MANDATORY on this board: it is an EARLY ESP32-P4 sample, "revision v1.3" ----
# A fresh IDF v5.5.4 project defaults to CONFIG_ESP32P4_REV_MIN_301 (v3.1+) and the
# flash step then aborts:
#   A fatal error occurred: bootloader/bootloader.bin requires chip revision in
#   range [v3.1 - v3.99] (this chip is revision v1.3). Use --force to flash anyway.
# Do NOT use --force: the min-rev is baked into the image header, and per IDF's own
# Kconfig comment "Support of ESP32-P4 rev. <3.0 and >=3.0 is mutually exclusive"
# -- v1.x and v3.x are different enough that a v3 build is not just "a header away".
#
# SELECTS_REV_LESS_V3 is the master gate: without it the REV_MIN_0/1/100 options are
# not even offered, so setting REV_MIN_100 alone silently does nothing (measured:
# sdkconfig still came out REV_MIN_FULL=301). It also switches other defaults for
# this silicon family (e.g. default CPU freq 360 MHz, PSRAM and PM options).
# p4_lcd -- the project that demonstrably runs on this board -- has both lines.
# Changing these requires a REBUILD, not just a reflash.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ---- Coprocessor OTA: take the image straight from a host flash partition ----
# No Wi-Fi / HTTPS involved on purpose: Wi-Fi interop is the very thing this OTA
# is meant to fix (host esp_hosted 3.0.5 vs factory co-processor 2.12.9), so the
# update path must not depend on it. The build system picks the newest .bin in
# components/ota_partition/slave_fw_bin/ and writes it to the 'slave_fw' partition.
CONFIG_OTA_METHOD_PARTITION=y
CONFIG_OTA_PARTITION_LABEL="slave_fw"
